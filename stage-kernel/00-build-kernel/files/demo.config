# Kconfig fragment merged on top of ${KERNEL_DEFCONFIG} (bcm2711_defconfig) by
# stage-kernel/00-build-kernel/00-run.sh. After `make olddefconfig` the script checks
# that every CONFIG line below survived, so a tweak that Kconfig dependencies would
# silently drop fails the build instead.

# Identity: `uname -r` on the Pi reports e.g. 6.12.41-v8-demo. The upstream tree is
# untagged, so LOCALVERSION_AUTO must stay off or a "+" gets appended.
CONFIG_LOCALVERSION="-v8-demo"
# CONFIG_LOCALVERSION_AUTO is not set

# Ship the kernel's own .config as /proc/config.gz: `zcat /proc/config.gz | grep DEMO`
# on the running board proves the custom configuration is what booted.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Boot the same kernel under `qemu-system-aarch64 -M virt` (see run-qemu.sh): virtio
# disk + NIC over PCI or MMIO, and the generic ECAM PCI host the virt machine exposes.
# Harmless on real hardware; the stock Debian kernel lacks these and cannot boot in virt.
CONFIG_PCI_HOST_GENERIC=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_RTC_DRV_PL031=y
