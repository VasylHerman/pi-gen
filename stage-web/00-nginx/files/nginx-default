# Demo site. Static files from /var/www/html; sysinfo.json is rewritten every few
# seconds by demo-sysinfo.service, so it must never be cached.
server {
	listen 80 default_server;
	listen [::]:80 default_server;
	server_name _;

	root /var/www/html;
	index index.html;

	location = /sysinfo.json {
		add_header Cache-Control "no-store";
	}

	location / {
		try_files $uri $uri/ =404;
	}
}
